{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://51.255.163.82/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "http://51.255.163.82/socket.io/"
    },
    {
      "source": "/socket.io/",
      "destination": "http://51.255.163.82/socket.io/"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "http://51.255.163.82/socket.io/$1"
    },
    {
      "source": "/((?!api|socket.io).*)",
      "destination": "/index.html"
    }
  ]
}